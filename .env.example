# PostgreSQL
DATABASE_URL=

# Public URL of the deployed Next.js application
APP_URL=https://omnicomm-360.vercel.app

# Claude / Anthropic
# Keep the real key only in Vercel Environment Variables or a local .env.local file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Twilio SMS / Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# Transactional Email (Resend HTTP API)
RESEND_API_KEY=
EMAIL_FROM=OmniComm 360 <noreply@example.com>

# Web Push (OneSignal)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
